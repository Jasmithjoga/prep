import java.util.*;
import java.io.*;
import java.math.*;
import java.time.*;

public class Main {
  public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    int n = sc.nextInt();
    int[] arr = new int[n];
    for(int i=0; i<n; i++){
      arr[i] = sc.nextInt();
    }
    int k = sc.nextInt();
    int left=0;
    int zerocount=0;
    int maxlen = Integer.MIN_VALUE;
    for(int right=0; right<n; right++){
      if(arr[right]==0){
        zerocount++;
      }
      while(zerocount>k){
        if(arr[left]==0){
          zerocount--;
        }
        left++;
      }
      maxlen = Math.max(maxlen, right-left+1);
    }
    if(maxlen==Integer.MIN_VALUE){
      System.out.print("0");
    }
    else{
      System.out.print(maxlen);
    }
  }
}
